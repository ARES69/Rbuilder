# RBUILDER talks to any OpenAI-compatible chat completions endpoint.
# Copy this file to .env.local and fill in the key, then restart `pnpm dev`.
#
# Without a key the app still runs: the chat explains the setup and the preview
# keeps rendering the current project. Local models (Ollama, LM Studio) are
# configured in Settings and need no key at all.

OPENAI_API_KEY=
# Any OpenAI-compatible base URL, for example:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   http://localhost:11434/v1   (Ollama)
OPENAI_BASE_URL=https://api.openai.com/v1

# Model id passed to the provider.
OPENAI_MODEL=gpt-4o-mini

# Optional: port. The dev server defaults to 5173, `pnpm start` to 5185.
# PORT=5173

# Optional: the standalone server binds loopback only unless told otherwise.
# HOST=127.0.0.1

# Optional: directory holding the built front end, served by `pnpm start`.
# RBUILDER_STATIC_DIR=dist

# Optional: where the terminal keeps its scratch copy of the project. Defaults
# to the folder the server runs in; the desktop build points it at %APPDATA%\RBuilder.
# RBUILDER_WORKSPACE_ROOT=

# Optional: shell used by the terminal. Defaults to bash, then cmd.exe or
# PowerShell on Windows machines without Git.
# RBUILDER_SHELL=bash

# Optional: let /api/proxy reach private and local addresses (development only).
# PROXY_ALLOW_PRIVATE=1
