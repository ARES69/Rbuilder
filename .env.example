# Freebuff Web talks to any OpenAI-compatible chat completions endpoint.
# Copy this file to .env.local and fill in the key, then restart `pnpm dev`.
#
# Without a key the app still runs: the chat explains the setup and the
# preview keeps showing the starter project.

OPENAI_API_KEY=
# Any OpenAI-compatible base URL, for example:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   http://localhost:11434/v1   (Ollama)
OPENAI_BASE_URL=https://api.openai.com/v1

# Model id passed to the provider.
OPENAI_MODEL=gpt-4o-mini

# Optional: dev server port (defaults to 5173).
# PORT=5173
